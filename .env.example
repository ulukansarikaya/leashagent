# Person 3 — chain / payments / identity
CHAIN_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113
POLICY_REGISTRY_ADDRESS=0x9d0f1e30aF144074f4A8bE191fd5DB4F1F51f68F
DECISION_LOG_ADDRESS=0xdC10FdDF2B58aeB674EBE4899A2a5C3276070d96
LOGGER_PRIVATE_KEY=
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
X402_FACILITATOR_URL=https://facilitator.payai.network
X402_NETWORK=avalanche-fuji
# deploy only
DEPLOYER_PRIVATE_KEY=
LOGGER_ADDRESS=

# Public demo gateway (docs/DEPLOY.md) — read by scripts/fuji-gateway.ts.
# Optional settings stay commented out: an empty value is passed as "" and would override the default.
# x402 pay-to address (required by the gateway; X402_PAY_TO overrides it)
DEPLOYER_ADDRESS=
# Caddy: your domain (automatic HTTPS) or :80 for plain HTTP on the server IP
SITE_ADDRESS=:80
# Shown in startup logs only, e.g. https://demo.example.com
# PUBLIC_URL=
# Gateway authorization key; a new one is generated on every start if unset
# GUARD_SIGNING_KEY=
# Another Fuji manifest with its own LOGGER key
# LEASH_DEPLOYMENT=packages/chain/deployments/fuji-p1.json
# OKX: leave OKX_MODE unset to fake the exchange. For a real OKX DEMO account (read key + trade key, NO withdraw):
# OKX_MODE=atk
# OKX_PROFILE=demo
# OKX_SITE=global
# OKX_READ_KEY=
# OKX_READ_SECRET=
# OKX_READ_PASSPHRASE=
# OKX_TRADE_KEY=
# OKX_TRADE_SECRET=
# OKX_TRADE_PASSPHRASE=
