    "demo:gateway": "tsx packages/mock-gateway/src/server.ts",
    "demo:agent": "tsx packages/agent/src/main.ts",
    "demo:attack": "tsx scripts/injection-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
