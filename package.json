{
  "name": "leashagent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:acceptance": "vitest run tests/acceptance",
    "test:contracts": "cd packages/chain && forge test",
    "build:contracts": "cd packages/chain && forge build && node scripts/gen-abi.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mock:gateway": "tsx packages/mock-gateway/src/server.ts",
    "agent": "tsx packages/agent/src/main.ts",
    "demo:attack": "tsx scripts/injection-demo.ts",
    "spike:atk": "tsx scripts/atk-spike.ts",
    "test:invariants": "vitest run tests/invariants tests/attacks",
    "gateway:dev": "tsx scripts/dev-gateway.ts",
    "gateway:fuji": "tsx --env-file=.env scripts/fuji-gateway.ts",
    "e2e:fuji": "tsx --env-file=.env scripts/fuji-e2e.ts",
    "agent:live": "tsx scripts/agent-live.ts",
    "demo:live": "tsx scripts/live-demo.ts",
    "e2e:okx-demo": "node --env-file-if-exists=.env --import tsx scripts/okx-demo-e2e.ts",
    "e2e:x402": "node --env-file-if-exists=.env --import tsx scripts/x402-e2e.ts",
    "gate": "node --env-file-if-exists=.env --import tsx scripts/gate.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "viem": "^2.21.0",
    "vitest": "^3.2.4"
  }
}
