{
  "name": "leashagent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:acceptance": "vitest run tests/acceptance",
    "test:contracts": "cd packages/chain && forge test",
    "build:contracts": "cd packages/chain && forge build && node scripts/gen-abi.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mock:gateway": "tsx packages/mock-gateway/src/server.ts",
    "agent": "tsx packages/agent/src/main.ts",
    "demo:attack": "tsx scripts/injection-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "viem": "^2.21.0",
    "vitest": "^3.2.4"
  }
}
