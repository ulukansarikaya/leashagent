{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true, "types": ["node"]
  },
  "include": ["packages/*/src", "tests", "scripts"]
}
